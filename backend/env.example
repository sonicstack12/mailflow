NODE_ENV=
PORT=

# Comma-separated list of allowed origins for browser apps (no trailing slashes)
# Local: http://localhost:5173,http://localhost:5174
# Render: https://mailflow-customer.onrender.com,https://mailflow-admin.onrender.com
CORS_ORIGINS=

# MongoDB (local) or Atlas (production), e.g.:
# mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mail-genie?retryWrites=true&w=majority
# URL-encode special characters in the password (@ -> %40)
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 32-byte key in base64 (used to encrypt SMTP passwords at rest)
# Generate: openssl rand -base64 32
SMTP_ENCRYPTION_KEY_BASE64=

# Seeded admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
